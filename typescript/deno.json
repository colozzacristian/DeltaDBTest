{
  "name": "@openajazz/jazztastic",
  "version": "0.2.4",
  "exports": "./src/index.ts",
  "desktop": {
    "app": {
      "name": "openajazz",
      "identifier": "com.openajazz.app"
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "OPENAJAZZ_MOCK=1 deno desktop --allow-env --allow-ffi --node-modules-dir=auto --hmr app.ts",
    "dev:real": "deno desktop --allow-env --allow-ffi --allow-read --node-modules-dir=auto --hmr app.ts",
    "build": "deno desktop --allow-env --allow-ffi --node-modules-dir=auto app.ts",
    "build:mock": "OPENAJAZZ_MOCK=1 deno desktop --allow-env --allow-ffi --node-modules-dir=auto app.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
